[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../rust/target/debug/libvr_game.so"
linux.release.x86_64 =   "res://../rust/target/release/libvr_game.so"
windows.debug.x86_64 =   "res://../rust/target/debug/vr_game.dll"
windows.release.x86_64 = "res://../rust/target/release/vr_game.dll"
macos.debug =            "res://../rust/target/debug/libvr_game.dylib"
macos.release =          "res://../rust/target/release/libvr_game.dylib"
macos.debug.arm64 =      "res://../rust/target/debug/libvr_game.dylib"
macos.release.arm64 =    "res://../rust/target/release/libvr_game.dylib"
web.debug.wasm32 =       "res://../rust/target/wasm32-unknown-emscripten/debug/vr_game.wasm"
web.release.wasm32 =     "res://../rust/target/wasm32-unknown-emscripten/release/vr_game.wasm"
